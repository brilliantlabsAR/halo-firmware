/ {
	chosen {
		zephyr,console = &lpuart;
		zephyr,shell-uart = &lpuart;
		zephyr,panel = &vga020;
	};

 	buttons {
        compatible = "gpio-keys";

        button_left: button_left {
            gpios = <&gpio5 6 GPIO_ACTIVE_LOW>;
            label = "Left";
        };

        button_right: button_right {
            gpios = <&gpio5 0 GPIO_ACTIVE_LOW>;
            label = "Right";
        };

        button_up: button_up {
            gpios = <&gpio5 5 GPIO_ACTIVE_LOW>;
            label = "Up";
        };

        button_down: button_down {
            gpios = <&gpio5 4 GPIO_ACTIVE_LOW>;
            label = "Down";
        };

        button_press: button_press {
            gpios = <&gpio5 7 GPIO_ACTIVE_LOW>;
            label = "Press";
        };
    };
};

&uart2 {
	status = "disabled";
};

&lpuart {
	status = "okay";
};


&pinctrl {
		pinctrl_i2c1: pinctrl_i2c1 {
		group0 {
			pinmux = < PIN_P2_6__I2C1_SDA_B >,
				 < PIN_P2_7__I2C1_SCL_B >;

			read_enable = < 0x1 >;
			driver_state_control = < 0x1 >;
		};
	};
};

&pinctrl_gpio5 {
	group0 {
		pinmux = < PIN_P5_0__GPIO >,
			 < PIN_P5_1__GPIO >,
			 < PIN_P5_2__GPIO >,
			 < PIN_P5_3__GPIO >,
			 < PIN_P5_4__GPIO >,
			 < PIN_P5_5__GPIO >,
			 < PIN_P5_6__GPIO >,
			 < PIN_P5_7__GPIO >;
		read_enable = < 0x1 >;
	};

	group1 {
		pinmux = < PIN_P5_0__GPIO >,
			 < PIN_P5_4__GPIO >,
			 < PIN_P5_5__GPIO >,
			 < PIN_P5_6__GPIO >,
			 < PIN_P5_7__GPIO >;
		driver_state_control = <1>;
	};
};


/ {
	soc {
		cdc200: cdc200@49031000 {
			width = <240>;
			hfront-porch = <16>;
			hback-porch = <48>;
			hsync-len = <96>;

			height = <320>;
			vfront-porch = <16>;
			vback-porch = <26>;
			vsync-len = <3>;

			hsync-active = <1>;
			vsync-active = <1>;
			de-active = <1>;
			pixelclk-active = <1>;

			clock-frequency = <8760000>;

			bg-color = <0>;
			enable-l1 = <1>;
			pixel-fmt-l1 = "rgb-888";
			def-back-color-l1 = <0>;
			win-x0-l1 = <0>;
			win-y0-l1 = <0>;
			win-x1-l1 = <240>;
			win-y1-l1 = <320>;
			blend-factor1-l1 = <4>;
			blend-factor2-l1 = <5>;
			const-alpha-l1 = <0xff>;
			enable-l2 = <0>;
			pixel-fmt-l2 = "undefined";
			win-x0-l2 = <0>;
			win-y0-l2 = <0>;
			win-x1-l2 = <0>;
			win-y1-l2 = <0>;
			blend-factor1-l2 = <6>;
			blend-factor2-l2 = <7>;
			const-alpha-l2 = <0xff>;
		};

		dtcm: dtcm@2000a000 {
			compatible = "alif,dtcm", "zephyr,memory-region";
			dtcm_global_base = <0x5880a000>;
			reg = <0x2000a000 DT_SIZE_K(1496)>;
			zephyr,memory-region = "DTCM";
		};

		/delete-node/ ns@2002a000;
		ns: ns@20140000 {
			compatible = "zephyr,memory-region", "mmio-region";
			reg = <0x20140000 DT_SIZE_K(256)>;
			zephyr,memory-region = "NS";
		};
		

	};

};

ns: &ns {
	status = "okay";
};


&i2c1 {
	status = "okay";
	tps65132: tps65132@3e {
		compatible = "ti,tps65132";
		reg = <0x3e>;
		supply-gpios = <&gpio2 1 GPIO_ACTIVE_HIGH>;
		apps = "40ma";
		
		veng: VENG {
			regulator-name = "veng";
			regulator-init-microvolt = <4500000>;
			enable-gpios = <&gpio7 4 GPIO_ACTIVE_HIGH>;
			startup-delay-us = <5000>;
			status = "okay";

		};

		vpos: VPOS {
			regulator-name = "vpos";
			regulator-init-microvolt = <5500000>;
			enable-gpios = <&gpio7 5 GPIO_ACTIVE_HIGH>;
			startup-delay-us = <5000>;   
			status = "okay";
		};
		status = "okay";
	};
	vga020: vga020@54 {
		compatible = "gz,vga020";
		mipi = <&mipi_dsi>;
      	reg = <0x54>;
		vpos-supply = <&vpos>;
    	veng-supply = <&veng>;
		reset-gpios = <&gpio5 3 GPIO_ACTIVE_LOW>;
      	width = <240>;
      	height = <320>;
		status = "okay";
    };     
};


&mipi_dsi {
	// dpi-video-pattern-gen = "vertical-color-bar";
	// dpi-video-pattern-gen = "horizontal-color-bar";
	// dpi-video-pattern-gen = "vertical-bit-error-rate";
	/delete-property/ frame-ack-en;  // vga020 not supported
	/delete-property/ ecc-recv-en;
	/delete-property/ crc-recv-en;
	vid-pkt-size = <240>;
	panel-max-lane-bandwidth = <500000000>;
	status = "okay";
};

&vga020{
	status = "okay";
};
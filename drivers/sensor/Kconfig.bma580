config BMA580
	bool "Bosch 3-axis Acceleration Sensor"
    default y
    depends on DT_HAS_BOSCH_BMA580_ENABLED
    select I2C
	help
       Enable driver for Bosch BMA580 (I2C-based)


if BMA580

choice
	prompt "Trigger mode"
	default BMA580_TRIGGER_GLOBAL_THREAD
	help
	  Specify the type of triggering to be used by the driver.

config BMA580_TRIGGER_NONE
	bool "No trigger"

config BMA580_TRIGGER_GLOBAL_THREAD
	bool "Use global thread"
	depends on GPIO
	select BMA580_TRIGGER

config BMA580_TRIGGER_OWN_THREAD
	bool "Use own thread"
	depends on GPIO
	select BMA580_TRIGGER

endchoice

config BMA580_TRIGGER
	bool

config BMA580_THREAD_PRIORITY
	int "Thread priority"
	depends on BMA580_TRIGGER_OWN_THREAD
	default 10
	help
	  Priority of thread used by the driver to handle interrupts.

config BMA580_THREAD_STACK_SIZE
	int "Thread stack size"
	depends on BMA580_TRIGGER_OWN_THREAD
	default 1024
	help
	  Stack size of thread used by the driver to handle interrupts.

endif # BMA580

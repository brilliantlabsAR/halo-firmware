menuconfig T5838
    bool "Digital Microphone (Audio) Drivers"
    default y
    depends on DT_HAS_INVENSENSE_T5838_ALIF_PDM_ENABLED
    help
        Enable Digital Microphone Driver Configuration.

if T5838

module = T5838
module-str = T5838 microphone driver for alif pdm
source "subsys/logging/Kconfig.template.log_config"

config T5838_INIT_PRIORITY
    int "Init priority"
    default 80
    help
        Audio Digital Microphone device driver initialization priority.

config T5838_AAD_TRIGGER
    bool "Enable AAD functionality"
    default y
    depends on GPIO
    help
        Enable Acoustic Activity Detection (AAD) triggering functionality.

choice
    prompt "AAD Trigger mode"
    default T5838_AAD_TRIGGER_GLOBAL_THREAD
    help
        Specify the type of triggering to be used by the AAD functionality.

config T5838_AAD_TRIGGER_NONE
    bool "No trigger"
    help
        No triggering mechanism is used for AAD interrupts.

config T5838_AAD_TRIGGER_GLOBAL_THREAD
    bool "Use global thread"
    depends on GPIO
    select T5838_AAD_TRIGGER
    help
        Use a global work queue to handle AAD wake interrupts.

config T5838_AAD_TRIGGER_OWN_THREAD
    bool "Use own thread"
    depends on GPIO
	select T5838_AAD_TRIGGER
    help
        Use a dedicated thread to handle AAD wake interrupts.

endchoice

config T5838_AAD_TRIGGER_THREAD_PRIORITY
    int "Thread priority"
    depends on T5838_AAD_TRIGGER_OWN_THREAD
    default 10
    help
        Priority of the thread used by the driver to handle AAD wake interrupts.

config T5838_AAD_TRIGGER_STACK_SIZE
    int "Thread stack size"
    depends on T5838_AAD_TRIGGER_OWN_THREAD
    default 1024
    help
        Stack size of the thread used by the driver to handle AAD wake interrupts.

endif # T5838
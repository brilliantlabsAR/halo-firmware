config HALO_SHUTDOWN_SOUND_VOLUME
	int "Shutdown sound speaker volume"
	default 60
	range 0 100
	depends on HALO_SHUTDOWN_SOUND
	help
	  Temporary speaker volume for the shutdown sound. The previous persisted
	  speaker volume is restored after playback.

config HALO_CUE_GATE_DIRTY_BOOT
	bool "Skip boot/shutdown cues when the previous boot did not settle"
	default y
	depends on HALO_STARTUP_SOUND || HALO_SHUTDOWN_SOUND
	depends on HALO_FILE_MANAGER
	help
	  Persist a flag just before a boot or shutdown cue plays and clear
	  it once boot settles (image confirm) or the shutdown cue completes.
	  If the flag is already set when the boot cue would play, the
	  previous boot did not complete while a cue was active, and cues are
	  skipped for this boot. The flag is still cleared when this boot
	  settles, so cues return on the next power-on. Stored in flash so
	  the state survives a full power cycle.

config HALO_CUE_GATE_MIN_VOLTAGE_MV
	int "Minimum battery voltage (mV) for boot/shutdown cues, 0 disables"
	default 3400
	range 0 4400
	depends on HALO_STARTUP_SOUND || HALO_SHUTDOWN_SOUND
	depends on HALO_BATTERY_MANAGER
	help
	  Skip the boot/shutdown cues when a fresh battery reading taken just
	  before the cue is below this many millivolts. The reading is taken
	  under live system load, so it reflects the loaded (not resting)
	  battery voltage. The default corresponds to roughly the bottom
	  10-15% of charge: a low-battery courtesy skip where the cue adds
	  load for little benefit, chosen well below normal operating
	  voltages so cues are unaffected at everyday charge levels. 0
	  disables the check; the reading is logged at cue time either way.

config HALO_POWER_CUE_SOUND
	bool "Play power-off crossing cue"
	depends on HALO_SHUTDOWN_SOUND
	default y
	help
	  Play a very short blip the moment a button hold crosses the
	  power-off threshold (while still held). Deep sleep fires on
	  release, so the cue tells the user "release now to power off" -
	  or keep holding for the pairing / ship-mode levels.


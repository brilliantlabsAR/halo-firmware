config HALO_SHUTDOWN_SOUND_DURATION_MS
	int "Shutdown sound duration in milliseconds"
	default 700
	range 100 3000
	depends on HALO_SHUTDOWN_SOUND
	help
	  Playback duration. Kept short so shutdown stays prompt; this also
	  serves as a settle window between the button release and the actual

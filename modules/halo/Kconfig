	help
	  Enable Lua scripting runtime for Halo.
	  Provides REPL (Read-Eval-Print Loop) and data handling threads.
	  Requires BLE Lua Service to be enabled.

if HALO_LUA_RUNTIME

config HALO_LUA_REPL_TASK_STACK_SIZE
	int "REPL thread stack size (bytes)"
	default 65536
	help
	  Stack size for the Lua REPL thread (default 64KB).
	  This is the core Lua runtime thread that executes user scripts.
	  Large stack is needed for complex scripts, nested function calls,
	  and Lua's internal operations.


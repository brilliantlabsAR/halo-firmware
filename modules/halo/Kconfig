	default 84
	depends on HALO_STARTUP_SOUND
	help
	  Deterministic seed for the generated startup preset.

config HALO_STARTUP_SOUND_RETRY_MS
	int "Startup sound speaker-ready retry interval (ms)"
	default 50
	range 1 1000
	depends on HALO_STARTUP_SOUND
	help
	  How often to retry playback while the speaker is not yet ready. There is
	  no fixed pre-delay; the thread retries at this interval until the speaker
	  accepts playback (or the timeout below), logging the elapsed wait so the
	  real readiness latency is visible.

config HALO_STARTUP_SOUND_TIMEOUT_MS
	int "Startup sound speaker-ready timeout (ms)"
	default 2000
	range 0 10000
	depends on HALO_STARTUP_SOUND
	help
	  Give up trying to play the startup sound if the speaker is still not
	  ready after this long.

config HALO_STARTUP_SOUND_DURATION_MS

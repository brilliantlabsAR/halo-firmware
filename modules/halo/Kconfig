	int "Camera capture thread stack size (bytes)"
	default 16384
	depends on VIDEO
	help
	  Stack size for the camera capture thread (default 16KB).
	  This thread handles camera frame capture and JPEG encoding.
	  Requires CONFIG_VIDEO to be enabled.

config HALO_LUA_VIDEO_TASK_PRIORITY
	int "Camera capture thread priority"
	default 7
	range 0 15
	depends on VIDEO
	help
	  Priority level for the camera capture thread.

config HALO_LUA_CAMERA_JPEG_BUFFER_SIZE
	int "Camera JPEG buffer size (bytes)"
	default 131072
	depends on VIDEO
	help
	  Size of the camera JPEG buffer allocated in Static section (default 128KB).
	  This buffer is used to store JPEG compressed images from the camera.
	  Allocated statically at compile time to avoid runtime allocation failures.

# Audio configuration
menuconfig HALO_AUDIO_STREAM
	bool "Audio Stream Abstraction Layer"
	default y
	depends on HALO_LUA_RUNTIME
	help
	  Enable unified audio stream abstraction layer for PCM and LC3 formats.
	  
	  This provides a clean interface for:
	  - Automatic LC3 encoding/decoding
	  - Unified API for speaker and microphone
	  - Callback-based transport (supports BLE Lua, LE Audio, etc.)
	  - Multiple audio source/sink registration
	  
	  Both speaker and microphone modules depend on this component.

if HALO_AUDIO_STREAM

config HALO_LUA_SPEAKER
	bool "Enable speaker support"
	depends on AUDIO
	default y
	help
	  Enable Lua speaker API (frame.speaker.*).
	  
	  Supports:
	  - PCM and LC3 audio playback
	  - Volume control
	  - Automatic decoding from BLE audio stream
	  
	  Requires CONFIG_AUDIO and appropriate audio output device.

if HALO_LUA_SPEAKER

config HALO_LUA_SPEAKER_TASK_STACK_SIZE
	int "Speaker thread stack size (bytes)"
	default 8192
	help
	  Stack size for the speaker playback thread (default 8KB).
	  This thread reads audio from BLE, decodes if needed, and writes to hardware.

config HALO_LUA_SPEAKER_TASK_PRIORITY
	int "Speaker thread priority"
	default 8
	range 0 15
	help
	  Priority level for the speaker thread.
	  Lower number = higher priority.
	  Default 8 matches other audio/sensor tasks.

endif # HALO_LUA_SPEAKER

config HALO_LUA_MICROPHONE
	bool "Enable microphone support"
	depends on AUDIO
	default y
	help
	  Enable Lua microphone API (frame.microphone.*).
	  
	  Supports:
	  - PCM and LC3 audio capture
	  - AAD (Acoustic Activity Detection) callback
	  - Automatic encoding to BLE audio stream
	  - Ring buffer for asynchronous reading
	  
	  Requires CONFIG_AUDIO and appropriate audio input device (e.g., DMIC).

if HALO_LUA_MICROPHONE

config HALO_LUA_MICROPHONE_TASK_STACK_SIZE
	int "Microphone thread stack size (bytes)"
	default 8192
	help
	  Stack size for the microphone capture thread (default 8KB).
	  This thread reads audio from hardware, encodes if needed, and writes to BLE.

config HALO_LUA_MICROPHONE_TASK_PRIORITY
	int "Microphone thread priority"
	default 6
	range 0 15
	help
	  Priority level for the microphone thread.
	  Lower number = higher priority.
	  Default 6 matches other audio/sensor tasks.

config HALO_LUA_MICROPHONE_RING_BUFFER_SIZE
	int "Microphone ring buffer size (bytes)"
	default 65536
	help
	  Size of the ring buffer for microphone data (default 128KB).
	  This buffer stores captured audio data for asynchronous reading by Lua scripts.
	  Larger buffer allows for more buffering but uses more memory.

endif # HALO_LUA_MICROPHONE

config HALO_AUDIO_HPF
	bool "Enable high-pass filter EQ for speaker output"
	default n
	depends on HALO_LUA_SPEAKER
	help
	  Enable a biquad IIR high-pass filter on all audio output to the speaker,
	  applied in audio_speaker_write() (covers both LE Audio sink and Lua
	  speaker playback paths).

	  Default n: on Halo, bone-conduction speaker current protection is now
	  owned entirely by the MAX98357A driver chain
	  (CONFIG_MAX98357A_AUDIO_PROTECTION_EQ), which applies its own HPF,
	  voicing EQ and current-proxy energy limiter post-volume. Stacking this
	  stream-side HPF on top guts the TTS voice fundamentals (150-400 Hz)
	  without adding meaningful protection. Enable only for hardware whose
	  output driver has no protection of its own.

if HALO_AUDIO_HPF

config HALO_AUDIO_HPF_CUTOFF_HZ
	int "High-pass filter cutoff frequency (Hz)"
	default 300
	range 50 2000
	help
	  Cutoff frequency for the high-pass filter in Hz.
	  Frequencies below this are attenuated.

	  Recommended range for bone conduction speaker:
	  - 200-300 Hz: gentle roll-off, preserves bass warmth
	  - 300-500 Hz: moderate, good for current protection
	  - 500-800 Hz: aggressive, maximum protection

	  Default 300 Hz provides good protection while preserving voice quality.

config HALO_AUDIO_HPF_ORDER
	int "High-pass filter order"
	default 4
	range 2 4
	help
	  Filter order determines roll-off steepness:
	  - 2: Single biquad, -12 dB/octave roll-off
	  - 4: Cascaded biquads, -24 dB/octave roll-off (recommended)

	  Higher order gives steeper attenuation below cutoff but uses
	  slightly more CPU. Default 4 (Butterworth -24dB/oct) matches
	  the speaker manufacturer's EQ curve recommendation.

endif # HALO_AUDIO_HPF

config HALO_AUDIO_AEC
	bool "Acoustic echo cancellation on the microphone path"
	default n
	depends on HALO_LUA_MICROPHONE && HALO_LUA_SPEAKER
	depends on MAX98357A_AUDIO
	help
	  Cancel the bone-conduction speaker's leakage into the microphones
	  (adaptive NLMS FIR), so duplex voice applications don't hear the
	  device's own speech as user input. Runs on the microphone path
	  before encoding (and before any future beamforming stage); the
	  far-end reference is tapped in the MAX98357A driver at the I2S
	  send point, post volume and speaker-protection processing.

	  v1 operates when both the microphone and speaker sessions are
	  16 kHz mono; other formats pass through untouched. Runtime
	  toggle via frame.microphone.aec(true/false).

	  See applications/halo/tests/aec/README.md for the echo-path
	  identification data behind the defaults.

if HALO_AUDIO_AEC

config HALO_AUDIO_AEC_TAPS
	int "Adaptive filter length (taps at 16 kHz)"
	default 1024
	range 128 2048
	help
	  FIR length in samples at 16 kHz. Must cover the mic/speaker block
	  alignment slack (up to ~40 ms = 640 taps) plus the echo path's
	  impulse-response tail. Measured on Halo 08: 90% of linear IR
	  energy within ~40 ms of onset. 1024 taps = 64 ms.

	  CPU cost is ~2 * taps MACs per mic sample (float32, scalar):
	  1024 taps ~ 33 MMAC/s at 16 kHz.

config HALO_AUDIO_AEC_FDAF
	bool "Per-bin frequency-domain adaptation (partitioned-block FDAF)"
	default y
	select CMSIS_DSP
	select CMSIS_DSP_TRANSFORM
	help
	  Adapt the echo filter per frequency bin (partitioned-block
	  overlap-save FDAF, 1024-point FFT, 20 ms hop) instead of running
	  a time-domain NLMS across the whole band with one step size.

	  Real speech playback is spectrally sparse and pitch-periodic, and
	  the measured echo coherence is strongly frequency-dependent (~0.9
	  at 300-800 Hz falling to ~0.4 by 1.6-3.4 kHz): a single full-band
	  gradient lets the strong coherent bins dictate the step while the
	  rest accumulates weight noise, which capped voice-stimulus ERLE at
	  ~+2.4 dB on hardware. Per-bin normalization adapts each bin at its
	  own SNR, exploiting the coherent low band fully.

	  Uses CMSIS-DSP's Helium-accelerated FFT on the M55. The alignment
	  machinery (reference ring, stream epochs, hold-back, gating) is
	  identical to the time-domain build.

config HALO_AUDIO_AEC_FDAF_PARTS
	int "FDAF partitions (320 taps / 20 ms each)"
	depends on HALO_AUDIO_AEC_FDAF
	default 3
	range 1 6
	help
	  Number of 320-tap partitions; the covered echo span is
	  parts * 20 ms. The measured echo sits at ~9-10 ms bulk delay in
	  the analysis window with a compact tail: 3 partitions (60 ms)
	  cover it with margin. Must be <= HALO_AUDIO_AEC_TAPS / 320.

endif # HALO_AUDIO_AEC

config HALO_SFXR

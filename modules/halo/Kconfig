	  Playback duration. The SFXR generator streams silence if the generated
	  effect naturally ends before this duration.

config HALO_STARTUP_SOUND_VOLUME
	int "Startup sound speaker volume"
	default 100
	range 0 100
	depends on HALO_STARTUP_SOUND

menuconfig HALO
	bool "Halo Framework"
	default n
	select HALO_MEM_MANAGER
	select HALO_FILE_MANAGER
	select HALO_PM_MANAGER
	help
	  Enable Halo framework for Frame application.
	  This is the refactored version of Frame application components.
	  BLE is required and automatically enabled.

if HALO

module = HALO
module-str = Halo Framework
source "subsys/logging/Kconfig.template.log_config"

# Memory Manager Component (always enabled with HALO)
config HALO_MEM_MANAGER
	bool
	help
	  Unified memory manager with automatic resource tracking.
	  Supports internal and optional external SRAM regions.
	  This is a core component and always enabled when HALO is enabled.

if HALO_MEM_MANAGER

config HALO_MEM_MANAGER_STATS
	bool "Enable memory manager runtime statistics"
	default y
	select SYS_HEAP_RUNTIME_STATS
	help
	  Enable runtime statistics collection for memory manager.
	  This allows querying allocated, free, and maximum block sizes.
	  Disabling this can reduce memory overhead and improve performance.

config HALO_MEM_INTERNAL_SIZE
	int "Internal memory heap size (bytes)"
	default 102400
	help
	  Size of the internal memory heap in bytes.
	  This memory is statically allocated.

config HALO_MEM_USE_EXTERNAL_SRAM
	bool "Use external SRAM for memory allocation"
	default y
	help
	  Enable external SRAM for memory allocation.
	  This allows allocating memory from external SRAM region.

config HALO_MEM_EXTERNAL_SRAM_ADDR
	hex "External SRAM base address"
	default 0x00000000
	depends on HALO_MEM_USE_EXTERNAL_SRAM
	help
	  Base address of external SRAM region.
	  Note: If this is 0x00000000, it will be treated as invalid
	  and external memory will be disabled at runtime.

config HALO_MEM_EXTERNAL_SRAM_OFFSET
	int "External SRAM offset (bytes)"
	default 0
	depends on HALO_MEM_USE_EXTERNAL_SRAM
	help
	  Offset from base address where heap starts.
	  Useful to skip reserved regions or avoid NULL pointer (address 0).
	  For example, set to 102400 (100KB) to skip first 100KB.
	  Final heap address = BASE_ADDR + OFFSET.

config HALO_MEM_EXTERNAL_SRAM_SIZE
	int "External SRAM size (bytes)"
	default 524288
	depends on HALO_MEM_USE_EXTERNAL_SRAM
	help
	  Size of external SRAM heap in bytes (default 512KB).
	  This is the size of usable heap, not including offset.

endif # HALO_MEM_MANAGER

# File Manager Component (always enabled with HALO)
config HALO_FILE_MANAGER
	bool
	depends on ZEPHYR_LITTLEFS_MODULE
	select FILE_SYSTEM
	select FILE_SYSTEM_LITTLEFS
	select FLASH
	select FLASH_MAP
	select FLASH_PAGE_LAYOUT
	select SETTINGS
	help
	  File system manager with LittleFS and settings support.
	  Provides file operations and persistent settings storage.
	  This is a core component and always enabled when HALO is enabled.
	  Requires LittleFS module to be available in the build system.

# Power Manager Component
config HALO_PM_MANAGER
	bool
	select PM
	select PM_DEVICE
	help
	  Enable power management with sleep mode support.
	  Provides callback registration for suspend/resume events.
	  Supports light sleep and deep sleep modes.

# LED Manager Component
config HALO_LED_MANAGER
	bool "Enable LED manager"
	default y
	help
	  Enable LED management for status indication.
	  Provides API for controlling LEDs with patterns and effects.
	  Supports multiple LED configurations and event-driven updates.

# Watchdog Manager Component
config HALO_WATCHDOG_MANAGER
	bool "Enable watchdog manager"
	default n
	select WATCHDOG
	help
	  Enable watchdog timer management for system health monitoring.
	  Provides API for initializing, feeding, and configuring the watchdog.
	  Helps prevent system hangs by resetting on timeout.

if HALO_WATCHDOG_MANAGER

config HALO_WATCHDOG_TIMEOUT_MS
	int "Watchdog timeout (milliseconds)"
	default 1000
	range 100 10000
	help
	  Timeout period for the watchdog in milliseconds.
	  System will reset if not fed within this time.

config HALO_WATCHDOG_ALLOW_CALLBACK
	bool "Allow watchdog callback before reset"
	default y
	help
	  Enable callback function before watchdog reset.
	  Allows last-minute actions like logging or cleanup.

config HALO_WATCHDOG_AUTO_FEED
	bool "Enable automatic watchdog feeding"
	default n
	help
	  Enable automatic watchdog feeding thread.
	  When enabled, the watchdog will be fed automatically at regular intervals.
	  When disabled, application must manually call halo_watchdog_feed().

if HALO_WATCHDOG_AUTO_FEED

config HALO_WATCHDOG_AUTO_FEED_PRIORITY
	int "Automatic feed thread priority"
	default 1
	range 0 15
	help
	  Priority level for the automatic watchdog feeding thread.
	  Lower number = higher priority.

config HALO_WATCHDOG_AUTO_FEED_STACK_SIZE
	int "Automatic feed thread stack size (bytes)"
	default 512
	help
	  Stack size for the automatic watchdog feeding thread.

endif # HALO_WATCHDOG_AUTO_FEED

config HALO_WATCHDOG_FEED_INTERVAL_MS
	int "Default feed interval (milliseconds)"
	default 1000
	range 10 5000
	help
	  Default interval for feeding the watchdog in milliseconds.
	  Used for automatic feeding if enabled in application.

endif # HALO_WATCHDOG_MANAGER


# Battery Manager Component
config HALO_BATTERY_MANAGER
	bool "Enable battery manager"
	default y
	depends on SENSOR
	help
	  Enable battery monitoring and management.
	  Provides API for reading battery level, voltage, and charging status.
	  Supports event callbacks for battery state changes.
	  Requires a battery sensor (e.g., fuel gauge) to be configured.

if HALO_BATTERY_MANAGER

config HALO_BATTERY_UPDATE_INTERVAL_MS
	int "Battery update interval (milliseconds)"
	default 10000
	range 1000 60000
	help
	  Interval for periodic battery status updates in milliseconds.
	  The battery manager will automatically fetch battery data
	  and update LED status at this interval.
	  Default is 10000ms (10 seconds).
	  Set to 0 to disable periodic updates.

endif # HALO_BATTERY_MANAGER



# BLE Manager Component
config HALO_BLE_MANAGER
	bool "Enable BLE Manager"
	default y
	depends on BT
	depends on ALIF_BLE_HOST
	help
	  Enable unified BLE management framework.
	  Provides:
	  - Event-driven callback system with priority support
	  - Connection and advertising management
	  - Security and pairing management with file-based bond storage
	  - Service registration and lifecycle management
	  
	  This manager integrates with Alif BLE stack and provides
	  a clean, modular interface for BLE functionality.
	  
	  Requires: CONFIG_BT=y and CONFIG_BT_CUSTOM=y in prj.conf

if HALO_BLE_MANAGER

config HALO_BLE_MAX_SERVICES
	int "Maximum number of BLE services"
	default 8
	help
	  Maximum number of BLE GATT services that can be registered.
	  Each service consumes some memory for tracking.

config HALO_BLE_BOND_STORAGE
	bool "Enable bond data persistent storage"
	default y
	depends on HALO_FILE_MANAGER
	help
	  Enable persistent storage of bond data using file manager.
	  Bond information will be stored in /lfs/ble/ directory.
	  Requires HALO_FILE_MANAGER to be enabled.

config HALO_BLE_AUTO_RECONNECT
	bool "Enable automatic reconnection"
	default n
	help
	  Automatically start advertising after disconnection.
	  This allows the device to be reconnected without manual intervention.

config HALO_BLE_REQUIRE_PAIRING
	bool "Require pairing for all connections"
	default n
	help
	  Require pairing/bonding before allowing device connections.
	  
	  When enabled (y):
	  - Only previously bonded devices can connect
	  - New devices must complete pairing process
	  - Connections from unknown devices are rejected if already bonded to another device
	  
	  When disabled (n):
	  - Any device can connect without pairing
	  - Useful for development and testing
	  - Connection confirmation always succeeds without bond data check
	  
	  Default: disabled for easier testing and development

config HALO_BLE_ALLOW_BOND_OVERWRITE
	bool "Allow overwriting existing bond data"
	default n
	depends on HALO_BLE_BOND_STORAGE
	help
	  Allow new devices to pair and overwrite existing bond data.
	  
	  When enabled (y):
	  - Any device can initiate pairing even if bond data exists
	  - New pairing will replace the old bond information
	  - Useful for testing and development when switching between devices
	  
	  When disabled (n):
	  - Only unbonded devices can complete pairing process
	  - If bond data exists, new pairing attempts are rejected
	  - More secure - prevents accidental bond overwrites
	  
	  Default: disabled for security. Enable for flexible testing.

config HALO_BLE_MAX_BONDS
	int "Maximum number of bonded peer devices"
	default 5
	range 1 8
	help
	  Number of bond table slots. When a new device pairs with the table
	  full, the least-recently-connected bond is evicted. Only one peer
	  can be connected at a time regardless of this value. See PAIRING.md.

config HALO_BLE_PAIRING_WINDOW_SEC
	int "Pairing window duration (seconds)"
	default 60
	range 10 600
	help
	  How long the device accepts a new (unknown) peer after the pairing
	  button hold (8 s). While the window is open, already-bonded peers
	  are rejected so the new device can connect and pair. The window
	  closes early as soon as a new bond is committed.

config HALO_BLE_BATTERY_SERVICE
	bool "Enable BLE Battery Service (0x180F)"
	default y
	depends on SENSOR
	depends on HALO_BATTERY_MANAGER
	help
	  Enable BLE Battery Service using generic GATT API.
	  This provides standard Battery Service (UUID 0x180F) with
	  Battery Level characteristic (UUID 0x2A19).
	  
	  Automatically integrates with battery_manager for level updates.
	  Supports notifications when battery level changes.
	  
	  When enabled, the Battery Service will be automatically registered
	  and advertised to BLE clients.

config HALO_BLE_LUA_SERVICE
	bool "Enable BLE Lua Service"
	default n
	help
	  Enable BLE Lua Service for script execution and data transport.
	  
	  This service provides multiple characteristics:
	  - RX/TX: REPL command input/output and data transfer
	  - Video: Video stream transmission
	  - Audio RX/TX: Audio input/output
	  
	  Service UUID: 7A230001-5475-A6A4-654C-8431F6AD49C4
	  
	  When enabled, the service will be automatically registered
	  and available for BLE clients to communicate with the Lua engine.

config HALO_BLE_OTA_SERVICE
	bool "Enable BLE OTA Service (SMP)"
	default y
	depends on MCUMGR
	help
	  Enable BLE OTA (Over-The-Air) Service using SMP protocol.
	  
	  This service implements Simple Management Protocol (SMP) over BLE
	  for firmware updates and device management operations such as:
	  - Firmware image upload and management
	  - Device reset and boot slot management
	  - File system operations
	  - Shell command execution
	  
	  Service UUID: 8D53DC1D-1DB7-4CD3-868B-8A527460AA84
	  Characteristic UUID: DA2E7828-FBCE-4E01-AE9E-261174997C48
	  
	  When enabled, the service will be automatically registered
	  and available for BLE clients to perform firmware updates.
	  
	  Requires MCUmgr to be enabled in the project configuration.

config HALO_SE_MGMT
	bool "Enable SE Management (requires BLE OTA)"
	default y
	depends on HALO_BLE_OTA_SERVICE
	help
	  Enable Security Element (SE) firmware management over BLE.
	  
	  This extends the BLE OTA service with SE-specific commands:
	  - SE firmware upload and update
	  - SE version querying
	  - Automatic reboot after successful update
	  
	  Uses SMP group ID 64 for SE management commands.
	  Requires BLE OTA service to be enabled for transport.
	  
	  SE firmware buffer is dynamically allocated from internal SRAM
	  based on the actual firmware size during transfer.

config HALO_BLE_ANCS_CLIENT
	bool "Enable ANCS client (iOS notifications)"
	default y
	help
	  Enable a GATT client for the Apple Notification Center Service
	  (ANCS) exposed by a connected iOS device.

	  Service UUID: 7905F431-B5CE-4E99-A40F-4B1E122D00D0

	  The service is discovered automatically on connection; the
	  Notification Source / Data Source subscriptions are established
	  once the link is encrypted (bonded) and an application consumer
	  (frame.ancs Lua API) enables them. On non-iOS centrals the
	  service is simply reported unavailable.

if HALO_BLE_ANCS_CLIENT

config HALO_BLE_ANCS_RESPONSE_BUF_SIZE
	int "ANCS attribute response buffer size (bytes)"
	default 1024
	range 128 4096
	help
	  Reassembly buffer for Get Notification Attributes / Get App
	  Attributes responses arriving over the Data Source
	  characteristic. Must be large enough for the largest requested
	  attribute set (title + subtitle + message + labels + overhead).

config HALO_BLE_ANCS_NOTIF_QUEUE_LEN
	int "ANCS notification event queue length"
	default 16
	range 4 64
	help
	  Number of Notification Source events buffered between the BLE
	  thread and the Lua callback. iOS replays every existing
	  notification when the accessory subscribes, so bursts occur.
	  On overflow the oldest events are dropped (a drop count is
	  reported to the Lua callback).

config HALO_BLE_ANCS_APP_NAME_MAX_LEN
	int "ANCS app display name maximum length (bytes)"
	default 128
	range 16 256
	help
	  Maximum stored length of an app display name returned by a
	  Get App Attributes request.

config HALO_BLE_ANCS_SOLICIT_ADV
	bool "Solicit ANCS in scan response data"
	default y
	help
	  Include the ANCS UUID in a Service Solicitation AD structure
	  (type 0x15) in the scan response, as recommended by Apple so
	  iOS knows the accessory wants notification access.

endif # HALO_BLE_ANCS_CLIENT

config HALO_BLE_DFU_BUTTON_HOLD_TIME_MS
	int "BLE DFU button hold time (milliseconds)"
	default 10000
	range 1000 60000
	help
	  Time in milliseconds that the button must be held to enter BLE DFU mode.
	  Default is 10000ms (10 seconds).

config HALO_BLE_DFU_INACTIVITY_TIMEOUT_MS
	int "BLE DFU inactivity timeout (milliseconds)"
	default 120000
	range 30000 600000
	help
	  Time in milliseconds of inactivity before automatically exiting BLE DFU mode.
	  Default is 120000ms (2 minutes).

if HALO_BLE_LUA_SERVICE

config HALO_LUA_MAX_REPL_SIZE
	int "Maximum REPL buffer size (bytes)"
	default 1024
	help
	  Size of the ring buffer for REPL command input.
	  This buffer stores incoming commands from the BLE client
	  before they are processed by the Lua interpreter.

config HALO_LUA_MAX_DATA_SIZE
	int "Maximum data buffer size (bytes)"
	default 4096
	help
	  Size of the ring buffer for binary data transfer.
	  This buffer is used for data transfers between the BLE client
	  and the Lua engine (separate from REPL commands).

config HALO_AUDIO_MAX_DATA_SIZE
	int "Maximum audio buffer size (bytes)"
	default 32768
	help
	  Size of the ring buffer for audio input data.
	  This buffer stores incoming audio data from the BLE client
	  before it is processed by the application.

endif # HALO_BLE_LUA_SERVICE

if HALO_BLE_AUDIO_SERVICE

config HALO_BLE_AUDIO_SINK_ENABLE
	bool "Enable LE Audio Sink (Speaker)"
	default n
	help
	  Enable LE Audio sink functionality (speaker output).
	  
	  When enabled (y):
	  - Device can receive audio streams from remote devices
	  - Registers PACS sink capabilities
	  - Allocates ASE for audio reception
	  
	  When disabled (n):
	  - No audio reception capability
	  - Source-only mode (microphone only)
	  
	  Default: enabled

config HALO_BLE_AUDIO_SOURCE_ENABLE
	bool "Enable LE Audio Source (Microphone)"
	default n
	help
	  Enable LE Audio source functionality (microphone input).
	  
	  When enabled (y):
	  - Device can send audio streams to remote devices
	  - Registers PACS source capabilities
	  - Allocates ASE for audio transmission
	  
	  When disabled (n):
	  - No audio transmission capability
	  - Sink-only mode (speaker only)

	  Default: enabled

config HALO_BLE_AUDIO_MICS
	bool "Microphone Control Service (MICS/MICP)"
	default y
	depends on HALO_BLE_AUDIO_SOURCE_ENABLE
	help
	  Expose the standard LE Audio Microphone Control Service so the
	  connected host can mute/unmute the microphone.

	  When muted by the host, the LE Audio source stream keeps its ISO
	  cadence but transmits silence, as the Microphone Control Profile
	  requires.

	  Default: enabled

config HALO_BLE_AUDIO_AICS
	bool "AICS gain instance in MICS"
	default n
	depends on HALO_BLE_AUDIO_MICS
	help
	  Include an Audio Input Control Service instance in MICS, exposing
	  microphone gain (-10..+10 dB) to the host.

	  Costs one GATT user slot from the BLE ROM's fixed pool
	  (BLE_GATT_USER_NB = 12), which is fully subscribed when the ANCS
	  client (HALO_BLE_ANCS_CLIENT) is enabled - enabling both makes
	  whichever registers last (ANCS) fail with GAP_ERR_INSUFF_RESOURCES.
	  Without AICS, MICS still provides the standard Mute control, and
	  microphone gain remains adjustable via frame.microphone.gain().

	  Default: disabled

config HALO_BLE_AUDIO_SOURCE_HQ
	bool "High-quality source sample rates (32/48 kHz)"
	default y
	depends on HALO_BLE_AUDIO_SOURCE_ENABLE
	help
	  Advertise 32 kHz and 48 kHz LC3 source (microphone) capabilities in
	  addition to the baseline 8/16 kHz voice configurations. The PDM
	  front-end natively supports these rates (24/44.1 kHz are NOT
	  supported and are never advertised).

	  Disable if CPU load or memory pressure from high-rate capture and
	  LC3 encoding becomes a problem on the target.

	  Default: enabled

config HALO_BLE_AUDIO_OUTPUT_STEREO
	bool "Stereo audio output (Sink/Speaker)"
	default n
	depends on HALO_BLE_AUDIO_SINK_ENABLE
	help
	  Enable stereo audio output for LE Audio sink.
	  
	  When enabled (y):
	  - Mono input is duplicated to both L/R channels
	  - Uses more memory for interleaved stereo buffer
	  - Speaker initialized with 2 channels
	  
	  When disabled (n):
	  - Direct mono output (single channel)
	  - Less memory usage
	  - Simpler processing pipeline
	  
	  Default: disabled (mono output)

config HALO_BLE_AUDIO_INPUT_STEREO
	bool "Stereo audio input (Source/Microphone)"
	default n
	depends on HALO_BLE_AUDIO_SOURCE_ENABLE
	help
	  Enable stereo audio input for LE Audio source.
	  
	  When enabled (y):
	  - Microphone captures 2 channels (L/R)
	  - Advertises stereo capability to remote device
	  
	  When disabled (n):
	  - Microphone captures 1 channel (mono)
	  - Advertises mono capability to remote device
	  
	  Default: disabled (mono input)

endif # HALO_BLE_AUDIO

endif # HALO_BLE_MANAGER


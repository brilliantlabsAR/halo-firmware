config HALO_BOOT_LOGO
	bool "Show boot logo splash"
	default n
	depends on CDC200
	select LZ4
	help
	  Draw a compressed logo bitmap during early boot, before the Lua
	  runtime (and main.lua) start, so it cannot be clobbered by the app.
	  The display boots in power-save: the splash resumes the panel to draw,
	  then returns it to power-save for the application to bring up again.

config HALO_BOOT_LOGO_MAX_RAW_BYTES
	int "Boot logo decompression buffer size (bytes)"
	default 8192
	depends on HALO_BOOT_LOGO
	help
	  Size of the static scratch buffer holding the decompressed 4-bit packed
	  logo (2 px/byte). Must be >= width*height/2 of the asset; 96x96 needs
	  4608 bytes.

config HALO_BOOT_LOGO_MIN_HOLD_MS
	int "Boot logo minimum on-screen time (ms)"
	default 3000
	depends on HALO_BOOT_LOGO
	help
	  Minimum time the logo stays on screen. When CONFIG_HALO_STARTUP_SOUND
	  is enabled the logo is held for max(startup sound, this), so a short
	  sound no longer cuts the splash off early.

config HALO_BOOT_LOGO_UNPAIRED_HOLD_MS
	int "Boot logo on-screen time when unpaired (ms)"
	default 10000
	depends on HALO_BOOT_LOGO
	help
	  Minimum time the logo stays on screen when the device boots with no
	  BLE bond stored. Held longer than the paired case, with the device
	  name drawn under the logo, so the user can identify the device while
	  pairing it for the first time.


config HALO_BLE_AUDIO_SERVICE
	bool "Enable BLE Audio Service (LE Audio)"
	default n
	depends on HALO_BLE_MANAGER
	help
	  Enable BLE Audio Service for LE Audio support.
	  
	  This service implements LE Audio profiles and codecs,
	  allowing audio streaming over BLE using LC3 codec.
	  
	  When enabled, the service will be automatically registered
	  and available for BLE clients to stream audio.


	int "Data handler thread stack size (bytes)"
	default 8192
	help
	  Stack size for the Lua data handler thread (default 8KB).
	  Handles binary data from BLE and invokes Lua callbacks.

config HALO_LUA_DATA_TASK_PRIORITY
	int "Data handler thread priority"
	default 7
	range 0 15
	help
	  Priority level for the Lua data handler thread.

